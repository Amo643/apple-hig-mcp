{
  "name": "@amo643/apple-hig-mcp",
  "version": "1.0.0",
  "description": "High-performance Model Context Protocol (MCP) server for live Apple Human Interface Guidelines (HIG)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "apple-hig-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "data"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amo643/apple-hig-mcp.git"
  },
  "homepage": "https://github.com/Amo643/apple-hig-mcp#readme",
